# WhisperLite serving configuration.
# Copy to `.env` and adjust; never commit a real `.env`.

# Path to a trained checkpoint produced by `whisperlite train`.
WHISPERLITE_CHECKPOINT=/models/best.pt

# Compute device: auto | cpu | cuda | cuda:0 ...
WHISPERLITE_DEVICE=auto

# Comma-separated API keys accepted as `Authorization: Bearer <key>`.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# REQUIRED unless WHISPERLITE_AUTH_ENABLED=0 (development only).
WHISPERLITE_API_KEYS=

# Set to 0 to disable authentication (local development only).
WHISPERLITE_AUTH_ENABLED=1

# Per-key request rate limit (requests per minute) and burst allowance.
WHISPERLITE_RATE_LIMIT_RPM=60
WHISPERLITE_RATE_LIMIT_BURST=10

# Upload and audio-length limits.
WHISPERLITE_MAX_UPLOAD_MB=25
WHISPERLITE_MAX_AUDIO_SECONDS=600

# Default decoding parameters (overridable per request within bounds).
WHISPERLITE_BEAM_SIZE=1
WHISPERLITE_TEMPERATURE=0.0

# Maximum concurrent transcriptions per worker process.
WHISPERLITE_MAX_CONCURRENCY=2

# Comma-separated CORS origins (empty = CORS disabled).
WHISPERLITE_CORS_ORIGINS=

# Logging: DEBUG | INFO | WARNING | ERROR, and 1 for JSON logs.
WHISPERLITE_LOG_LEVEL=INFO
WHISPERLITE_LOG_JSON=1
